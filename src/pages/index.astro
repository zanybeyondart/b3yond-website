<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#061114" />
    <meta name="description" content="B3YOND" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>B3YOND</title>
    <style>
      :root {
        --bg: #061114;
        --teal: #1d8899;
        --teal-light: #55b6c4;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: radial-gradient(circle at 50% 45%, #0b1714 0%, var(--bg) 55%, #010202 100%);
      }

      body {
        position: relative;
        isolation: isolate;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 42px 42px;
      }

      .particle-field,
      .field,
      .noise,
      .vignette {
        position: fixed;
        inset: 0;
      }

      .particle-field {
        width: 100%;
        height: 100%;
      }

      .field {
        display: grid;
        place-items: center;
        perspective: 1400px;
        overflow: hidden;
      }

      .noise,
      .vignette {
        pointer-events: none;
      }

      .noise {
        z-index: 10;
        opacity: 0.1;
        mix-blend-mode: soft-light;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
      }

      .vignette {
        z-index: 11;
        background: radial-gradient(circle, transparent 45%, rgba(0, 0, 0, 0.24) 75%, rgba(0, 0, 0, 0.64) 100%);
      }

      .quote-link {
        position: fixed;
        z-index: 21;
        left: 50%;
        bottom: max(7vh, calc(env(safe-area-inset-bottom) + 1rem));
        transform: translateX(-50%);
        inline-size: max-content;
        max-inline-size: calc(100% - 2rem);
        padding: 0.85rem 1.25rem;
        border: 1px solid var(--teal-light);
        border-radius: 2rem;
        background: var(--bg);
        color: #e3f5f7;
        font: 600 1rem/1.3 system-ui, sans-serif;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
      }

      .quote-link:hover,
      .quote-link:focus-visible {
        background: var(--teal-light);
        color: var(--bg);
      }

      .quote-link:focus-visible {
        outline: 2px solid white;
        outline-offset: 4px;
      }

      .cursor-glow {
        position: fixed;
        z-index: 20;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, rgba(29, 136, 153, 0.18), rgba(29, 136, 153, 0.07) 38%, transparent 72%);
        filter: blur(10px);
        transition: opacity 180ms ease;
      }

      .halo {
        position: absolute;
        width: 68vmin;
        height: 68vmin;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          rgba(85, 182, 196, 0.1) 0%,
          rgba(29, 136, 153, 0.1) 16%,
          rgba(29, 136, 153, 0.04) 36%,
          transparent 67%
        );
        filter: blur(18px);
        animation: pulse 4s ease-in-out infinite;
      }

      .core-stage {
        position: relative;
        width: min(52vmin, 540px);
        aspect-ratio: 1;
        transform-style: preserve-3d;
        animation: float 6s ease-in-out infinite;
      }

      .core {
        position: absolute;
        inset: 0;
        transform-style: preserve-3d;
        transition: transform 180ms ease-out;
        will-change: transform;
      }

      .ring {
        position: absolute;
        inset: 0;
        border: 1px solid rgba(85, 182, 196, 0.28);
        border-radius: 50%;
        box-shadow:
          0 0 22px rgba(29, 136, 153, 0.18),
          inset 0 0 28px rgba(29, 136, 153, 0.08);
        transform-style: preserve-3d;
      }

      .r1 {
        animation: spin-x 8s linear infinite;
      }

      .r2 {
        inset: 8%;
        border-color: rgba(255, 255, 255, 0.16);
        animation: spin-y 11s linear infinite reverse;
      }

      .r3 {
        inset: 16%;
        border-color: rgba(29, 136, 153, 0.65);
        animation: spin-diagonal 7s linear infinite;
      }

      .r4 {
        inset: 25%;
        border-color: rgba(255, 255, 255, 0.1);
        animation: spin-tilt 9s linear infinite reverse;
      }

      .r5 {
        inset: 35%;
        border: 0;
        background: radial-gradient(
          circle at 40% 38%,
          #a7d8df 0%,
          var(--teal-light) 12%,
          #1d6f79 34%,
          var(--bg) 68%,
          #000 100%
        );
        box-shadow:
          0 0 90px rgba(29, 136, 153, 0.35),
          0 0 160px rgba(29, 136, 153, 0.12);
        animation: pulse-core 3.6s ease-in-out infinite;
      }

      .orbit {
        position: absolute;
        inset: -10%;
        border: 1px dashed rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        animation: orbit 18s linear infinite;
      }

      .satellite {
        position: absolute;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: radial-gradient(
          circle,
          #d6fff7 0%,
          var(--teal-light) 30%,
          var(--teal) 65%,
          rgba(29, 136, 153, 0.2) 100%
        );
        box-shadow:
          0 0 18px rgba(85, 182, 196, 0.7),
          0 0 36px rgba(29, 136, 153, 0.35);
      }

      .s1 {
        top: 4%;
        left: 50%;
        transform: translateX(-50%);
      }

      .s2 {
        top: 50%;
        left: 8%;
        width: 10px;
        height: 10px;
        transform: translateY(-50%);
      }

      .s3 {
        top: 50%;
        right: 8%;
        width: 12px;
        height: 12px;
        transform: translateY(-50%);
      }

      .s4 {
        bottom: 6%;
        left: 50%;
        width: 9px;
        height: 9px;
        transform: translateX(-50%);
      }

      .beam {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1px;
        height: 100vh;
        opacity: 0.75;
        transform: translate(-50%, -50%);
        background: linear-gradient(
          to bottom,
          transparent 0%,
          rgba(85, 182, 196, 0.06) 18%,
          rgba(85, 182, 196, 0.22) 48%,
          rgba(85, 182, 196, 0.06) 82%,
          transparent 100%
        );
        filter: blur(0.3px);
      }

      .b2 {
        transform: translate(-50%, -50%) rotate(90deg);
      }

      .b3 {
        opacity: 0.32;
        transform: translate(-50%, -50%) rotate(45deg);
      }

      .b4 {
        opacity: 0.32;
        transform: translate(-50%, -50%) rotate(-45deg);
      }

      .scan {
        position: absolute;
        inset: -25%;
        border-radius: 50%;
        background: conic-gradient(
          from 0deg,
          transparent 0 80deg,
          rgba(85, 182, 196, 0.08) 100deg,
          transparent 120deg 360deg
        );
        mix-blend-mode: screen;
        filter: blur(2px);
        animation: scan 5s linear infinite;
      }

      @keyframes float {
        0%,
        100% {
          transform: translateY(-10px) rotateZ(-2deg);
        }
        50% {
          transform: translateY(16px) rotateZ(2deg);
        }
      }

      @keyframes spin-x {
        to {
          transform: rotateX(360deg) rotateZ(16deg);
        }
      }

      @keyframes spin-y {
        to {
          transform: rotateY(360deg) rotateX(68deg);
        }
      }

      @keyframes spin-diagonal {
        to {
          transform: rotateX(360deg) rotateY(360deg);
        }
      }

      @keyframes spin-tilt {
        to {
          transform: rotateZ(360deg) rotateX(58deg) rotateY(14deg);
        }
      }

      @keyframes orbit {
        to {
          transform: rotate(360deg);
        }
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 0.8;
          transform: scale(0.94);
        }
        50% {
          opacity: 1;
          transform: scale(1.03);
        }
      }

      @keyframes pulse-core {
        0%,
        100% {
          transform: scale(0.94);
          filter: brightness(0.92);
        }
        50% {
          transform: scale(1.05);
          filter: brightness(1.22);
        }
      }

      @keyframes scan {
        to {
          transform: rotate(360deg);
        }
      }

      @media (pointer: fine) {
        html,
        body {
          cursor: none;
        }
      }

      @media (pointer: coarse), (max-width: 900px) {
        .core-stage {
          width: min(60vmin, 380px);
        }

        .halo {
          width: 78vmin;
          height: 78vmin;
        }

        .cursor-glow {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 1ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <canvas class="particle-field" id="particles" aria-hidden="true"></canvas>
    <main class="field" aria-label="B3YOND animated brand experience">
      <div class="beam"></div>
      <div class="beam b2"></div>
      <div class="beam b3"></div>
      <div class="beam b4"></div>
      <div class="halo"></div>
      <div class="core-stage">
        <div class="core" id="core" aria-hidden="true">
          <div class="scan"></div>
          <div class="orbit">
            <div class="satellite s1"></div>
            <div class="satellite s2"></div>
            <div class="satellite s3"></div>
            <div class="satellite s4"></div>
          </div>
          <div class="ring r1"></div>
          <div class="ring r2"></div>
          <div class="ring r3"></div>
          <div class="ring r4"></div>
          <div class="ring r5"></div>
        </div>
      </div>
      <a class="quote-link" href="/photo-booth-quote">Get a photo booth quotation</a>
    </main>
    <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>
    <div class="noise"></div>
    <div class="vignette"></div>

    <script is:inline>
      const cursor = document.getElementById('cursor-glow');
      const core = document.getElementById('core');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse') return;
        cursor.style.left = `${event.clientX}px`;
        cursor.style.top = `${event.clientY}px`;
        cursor.style.opacity = '1';

        const x = (event.clientX / innerWidth - 0.5) * 18;
        const y = (event.clientY / innerHeight - 0.5) * -18;
        core.style.transform = `rotateY(${x}deg) rotateX(${y}deg)`;
      });

      document.documentElement.addEventListener('mouseleave', () => {
        cursor.style.opacity = '0';
      });

      addEventListener('pointerdown', () => {
        if (reduceMotion) return;
        core.animate([{ scale: 1 }, { scale: 1.07 }, { scale: 1 }], {
          duration: 500,
          easing: 'cubic-bezier(.2,.8,.2,1)',
        });
      });

      const canvas = document.getElementById('particles');
      const context = canvas.getContext('2d');
      let particles = [];
      let frame;

      function makeParticles() {
        const count = Math.min(140, Math.floor((innerWidth * innerHeight) / 12000));
        particles = Array.from({ length: count }, () => ({
          x: Math.random() * innerWidth,
          y: Math.random() * innerHeight,
          radius: Math.random() * 1.8 + 0.4,
          angle: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.5 + 0.15,
          opacity: Math.random() * 0.8 + 0.2,
        }));
      }

      function resize() {
        const ratio = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.round(innerWidth * ratio);
        canvas.height = Math.round(innerHeight * ratio);
        canvas.style.width = `${innerWidth}px`;
        canvas.style.height = `${innerHeight}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
        makeParticles();
      }

      function draw() {
        context.clearRect(0, 0, innerWidth, innerHeight);

        for (const particle of particles) {
          particle.angle += particle.speed * 0.01;
          particle.y -= particle.speed;
          particle.x += Math.sin(particle.angle) * 0.18;

          if (particle.y < -10) {
            particle.y = innerHeight + 10;
            particle.x = Math.random() * innerWidth;
          }

          const glow = context.createRadialGradient(
            particle.x,
            particle.y,
            0,
            particle.x,
            particle.y,
            particle.radius * 8
          );
          glow.addColorStop(0, `rgba(85,182,196,${0.25 * particle.opacity})`);
          glow.addColorStop(1, 'rgba(85,182,196,0)');
          context.fillStyle = glow;
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius * 8, 0, Math.PI * 2);
          context.fill();

          context.fillStyle = `rgba(190,230,236,${0.7 * particle.opacity})`;
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
          context.fill();
        }

        frame = requestAnimationFrame(draw);
      }

      addEventListener('resize', resize, { passive: true });
      resize();
      if (!reduceMotion) draw();

      addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
    </script>
  </body>
</html>
